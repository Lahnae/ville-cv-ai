{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run SWA (Frontend + Functions)",
      "type": "pwa-node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "args": [
        "swa",
        "start",
        "${workspaceFolder}",
        "--api-location",
        "api"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}